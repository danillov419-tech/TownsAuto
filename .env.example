# Supabase — copy this file to .env.local and fill in your project's values.
# Find these in your Supabase dashboard under Project Settings → API.

# Public (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server only. NEVER prefix with NEXT_PUBLIC and never commit it.
# Used by the `npm run seed` script to load sample inventory.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications over SMTP — optional but recommended.
# If these are unset, forms still work; they just won't send an email alert.
# Gmail example (requires 2-Step Verification + an App Password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=kelvinej191@gmail.com
#   SMTP_PASS=your-16-char-app-password   (NOT your normal Gmail password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: "true" to force SSL (auto-enabled when SMTP_PORT=465)
SMTP_SECURE=
# From header (defaults to SMTP_USER). For Gmail keep this as your SMTP_USER.
EMAIL_FROM=Towns Auto <kelvinej191@gmail.com>
# Where lead notifications are sent (defaults to the site email if unset).
NOTIFY_EMAIL=kelvinej191@gmail.com
