# Supabase — copy this file to .env.local and fill in your project's values.
# Find these in your Supabase dashboard under Project Settings → API.

# Public (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Secret — server only. NEVER prefix with NEXT_PUBLIC and never commit it.
# Used by the `npm run seed` script to load sample inventory.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications (Resend) — optional but recommended.
# Get a key at https://resend.com (free tier). If unset, forms still work,
# they just won't send an email alert.
RESEND_API_KEY=
# Verified sender. During setup you can use Resend's test sender:
#   EMAIL_FROM=Towns Auto <onboarding@resend.dev>
# For production, verify your domain in Resend and use e.g. noreply@townsautos.com
EMAIL_FROM=Towns Auto <onboarding@resend.dev>
# Where lead notifications are sent (defaults to the site email if unset).
NOTIFY_EMAIL=kelvinej191@gmail.com
